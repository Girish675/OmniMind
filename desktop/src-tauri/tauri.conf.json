{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "OmniMind",
  "version": "0.1.0-alpha.1",
  "identifier": "com.omnimind.desktop",
  "build": {
    "beforeDevCommand": "npm run build --prefix ../web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "OmniMind — Local Neural Engine",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "backgroundColor": "#090D14"
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:8080 http://127.0.0.1:8080; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' http://localhost:8080 http://127.0.0.1:8080"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
